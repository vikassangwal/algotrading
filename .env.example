# ELCO Trader Environment Configuration
# Copy this file to .env.development, .env.staging, or .env.production
# and fill in the values

# ============================================================
# Application
# ============================================================
ENVIRONMENT=development
LOG_LEVEL=DEBUG
ELCO_SECRET_KEY=your-super-secret-key-minimum-32-characters-long
ELCO_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ============================================================
# Database
# ============================================================
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql://elco:changeme@postgres:5432/elco_trader

# ============================================================
# Redis
# ============================================================
REDIS_URL=redis://redis:6379/0

# ============================================================
# Broker API Keys (Optional - for live trading)
# ============================================================
# Zerodha (Kite Connect)
ZERODHA_API_KEY=
ZERODHA_API_SECRET=

# Dhan
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# Upstox
UPSTOX_API_KEY=
UPSTOX_API_SECRET=

# Angel One
ANGLEONE_API_KEY=
ANGLEONE_CLIENT_ID=
ANGLEONE_PASSWORD=
ANGLEONE_TOTP_SECRET=

# Fyers
FYERS_APP_ID=
FYERS_SECRET_KEY=

# ============================================================
# External APIs
# ============================================================
# Alpha Vantage
ALPHA_VANTAGE_API_KEY=

# News API
NEWS_API_KEY=

# Telegram Bot (for notifications)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Slack Webhook
SLACK_WEBHOOK_URL=

# ============================================================
# Monitoring
# ============================================================
GRAFANA_PASSWORD=admin
PROMETHEUS_RETENTION_DAYS=30

# ============================================================
# Live Trading (Set to true only when ready!)
# ============================================================
LIVE_TRADING=false