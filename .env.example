# ELCO environment template — copy to .env and fill in real values.
# NEVER commit the real .env (it is gitignored). Rotate any token that leaks.

# Broker: "mock" (paper/safe, default) or "dhan" (live data)
BROKER_NAME=mock

# Dhan broker credentials (only needed when BROKER_NAME=dhan)
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# Trading safety: real orders are OFF unless this is exactly "true"
LIVE_TRADING=false

# Auth (Phase 4) — generate a long random secret for JWT signing
ELCO_JWT_SECRET=change-me-to-a-long-random-string
ELCO_ADMIN_PASSWORD=change-me
